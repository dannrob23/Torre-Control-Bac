# ---------------------------------------------------------------------------
# PLANTILLA de secretos para Streamlit Cloud.
#
# NO suba este archivo con valores reales al repositorio.
# En Streamlit Cloud se pegan en:  App -> Settings -> Secrets
#
# Copie este archivo como .streamlit/secrets.toml SOLO para probar en local.
# ---------------------------------------------------------------------------

# Proteccion de datos. En Streamlit Cloud, deje "completo".
#   "no"       -> datos reales (solo para uso local/interno)
#   "parcial"  -> oculta numeros de caso y oficinas
#   "completo" -> oculta casos, tecnicos y oficinas
TORRE_ANONIMIZAR = "completo"

# Ruta a una plantilla guardada en el repositorio (opcional).
# Si no se define, el usuario sube el Excel desde la interfaz.
# TORRE_EXCEL = "data/plantilla.xlsx"

# --- Telegram (OPCIONAL) ---------------------------------------------------
# Si los define, el dashboard podra enviar avisos al grupo.
# Importante: cualquiera con acceso a la app podria usarlos para enviar.
# En un tablero publico se recomienda NO configurarlos.
# TELEGRAM_BOT_TOKEN = "123456:ABC..."
# TELEGRAM_CHAT_ID = "-1001234567890"
